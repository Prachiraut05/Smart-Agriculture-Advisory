# ==========================================
# AI Farming Agent - Environment Variables
# ==========================================

# Google Gemini Vision API Key
# 1. Visit Google AI Studio: https://aistudio.google.com/
# 2. Click "Get API key" and create a free key
# 3. Rename this file to .env (or create .env in the project folder)
# 4. Paste your key below without quotes:
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Vision Model (Defaults to gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-2.0-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-1.5-flash
